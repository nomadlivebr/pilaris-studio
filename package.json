{
  "name": "pilaris-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Pilaris Studio — plataforma de gestão para estúdios de Pilates",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pilaris/api --filter=@pilaris/web",
    "dev:api": "turbo run dev --filter=@pilaris/api",
    "dev:web": "turbo run dev --filter=@pilaris/web",
    "dev:mobile": "turbo run dev --filter=@pilaris/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @pilaris/database db:generate",
    "db:migrate": "pnpm --filter @pilaris/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @pilaris/database db:migrate:deploy",
    "db:seed": "pnpm --filter @pilaris/database db:seed",
    "db:studio": "pnpm --filter @pilaris/database db:studio"
  },
  "devDependencies": {
    "@pilaris/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
