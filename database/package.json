{
  "name": "@pilaris/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma, migrations, seeds e cliente do banco PostgreSQL",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@pilaris/config": "workspace:*",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
