# =============================================================================
# Pilaris Studio — variáveis de ambiente do SERVIDOR (API + banco de dados)
# Copie para ".env" e preencha. O arquivo ".env" nunca deve ser versionado.
# Variáveis do painel web e do app ficam em apps/web/.env.example e
# apps/mobile/.env.example (somente valores públicos, nunca credenciais).
# =============================================================================

# Ambiente: development | test | production
NODE_ENV=development

# ----------------------------------------------------------------------------
# PostgreSQL (usado pelo docker-compose.yml)
# ----------------------------------------------------------------------------
POSTGRES_USER=pilaris
POSTGRES_PASSWORD=defina-uma-senha-local
POSTGRES_DB=pilaris_studio
# Porta exposta no host. 5433 evita conflito com um PostgreSQL já instalado no Windows.
POSTGRES_PORT=5433

# URL de conexão usada pelo Prisma e pela API
DATABASE_URL=postgresql://pilaris:defina-uma-senha-local@localhost:5433/pilaris_studio?schema=public

# ----------------------------------------------------------------------------
# API (NestJS)
# ----------------------------------------------------------------------------
API_PORT=3333
# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Habilita a documentação Swagger em /docs
SWAGGER_ENABLED=true

# ----------------------------------------------------------------------------
# Autenticação (Fase 2 — ainda não utilizadas)
# ----------------------------------------------------------------------------
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN=7d
